generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  xId        String?     @unique @db.VarChar(64)
  xUsername  String     @db.VarChar(255)
  xHandle    String     @unique @db.VarChar(255)
  xAvatar    String?    @db.Text
  totalPage  Int        @default(0)
  createdAt  DateTime   @default(now())

  pages      Page[]
  bookmarks  Bookmark[]
  votes      Match[]    @relation("VoterMatches")

  @@index([createdAt])
}

model Page {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  websiteUrl      String     @db.Text
  coverUrl        String?    @db.Text
  title           String     @db.VarChar(255)
  oneLiner        String?    @db.VarChar(500)
  elo             Int        @default(1000)
  bookmarked      Int        @default(0)
  tags            String[]
  createdAt       DateTime   @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks       Bookmark[]
  matchesAsA      Match[]    @relation("PageAMatches")
  matchesAsB      Match[]    @relation("PageBMatches")
  matchesWon      Match[]    @relation("WinningPageMatches")

  @@index([userId, createdAt])
  @@index([elo])
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  pageId     String   @db.Uuid
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([pageId])
}

model Match {
  id          String   @id @default(uuid()) @db.Uuid
  voterId     String   @db.Uuid
  pageAId     String   @db.Uuid
  pageBId     String   @db.Uuid
  winnerId    String   @db.Uuid
  eloABefore  Int
  eloBBefore  Int
  eloAAfter   Int
  eloBAfter   Int
  createdAt   DateTime @default(now())

  voter       User     @relation("VoterMatches", fields: [voterId], references: [id], onDelete: Cascade)
  pageA       Page     @relation("PageAMatches", fields: [pageAId], references: [id], onDelete: Cascade)
  pageB       Page     @relation("PageBMatches", fields: [pageBId], references: [id], onDelete: Cascade)
  winner      Page     @relation("WinningPageMatches", fields: [winnerId], references: [id], onDelete: Cascade)

  @@index([voterId, createdAt])
  @@index([pageAId])
  @@index([pageBId])
  @@index([winnerId])
}
